NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local Supabase (default for development). Values from `supabase status -o env` in backend/.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-PUBLISHABLE_KEY

# Production Supabase — only when you deliberately need real data.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-sb_publishable-key
