    "paths": {
        "/api/research/{ticker}": {
            "get": {
                "tags": [
                    "research"
                ],
                "summary": "Get Research",
                "operationId": "getResearch",
                "security": [
                    {
                        "HTTPBearer": []
                    }
                ],
                "parameters": [
                    {
                        "name": "ticker",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Ticker"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TickerDeepDive"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/research/{ticker}/sentiment-status": {
            "get": {
                "tags": [
                    "research"
                ],
                "summary": "Get Sentiment Status",
                "operationId": "getSentimentStatus",
