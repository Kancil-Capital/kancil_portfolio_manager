# Production / shared settings. Copy to .env.
# For local Supabase, also create .env.local (see .env.local.example); its values override these.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-sb_publishable-key
