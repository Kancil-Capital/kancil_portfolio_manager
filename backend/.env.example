# Local Supabase (default for development). Start it with `supabase start` from backend/,
# then copy the values from `supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=your-local-SECRET_KEY
SUPABASE_JWT_SECRET=your-local-JWT_SECRET

# Production Supabase — only when you deliberately need real data.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-sb_secret-key
# SUPABASE_JWT_SECRET=your-jwt-secret

ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
CORS_ORIGINS=["http://localhost:3000"]
